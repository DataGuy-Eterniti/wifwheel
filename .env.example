# Copy to .env and fill in. Never commit .env.

# --- payments: testnet with a mock $WIF (free) ---
NETWORK=testnet
DEPLOYER_KEY=0x_your_NEW_wallet_private_key   # a fresh wallet used only for this project
WIF_ADDRESS=                                  # leave empty on testnet: deploy.py creates a mock $WIF
WIFWHEEL_ADDRESS=                             # filled in after deploy.py runs
CHECK_FEE=10
REPORT_STAKE=100
REPORT_REWARD=50
BURN_BPS=5000

# --- token checks read real mainnet data (free, read-only) ---
SCAN_NETWORK=mainnet

# --- optional: AI-written explanations via any free OpenAI-compatible API ---
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
